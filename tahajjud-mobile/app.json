{
  "expo": {
    "name": "Tahajjud+",
    "slug": "tahajjud-plus",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tahajjudplus.app",
      "buildNumber": "4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tahajjud+ needs your location to accurately calculate the Qibla direction and prayer times for your current city.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tahajjud+ needs your location to accurately calculate the Qibla direction and prayer times for your current city.",
        "NSLocalNetworkUsageDescription": "Used for community features and syncing your prayers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "package": "com.tahajjudplus.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#020617",
          "sounds": [
            "./assets/sounds/tahajjud_alert.wav"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "826f6518-cc97-4065-bbfd-e0e8e51cb475"
      }
    }
  }
}